# Copier ce fichier en ".env" (à côté de l'exe) et renseigner votre mot de passe
# OBS WebSocket (Outils > Paramètres WebSocket obs dans OBS Studio).
# La GUI (onglet Paramètres) écrit aussi directement dans ce fichier.
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
OBS_SCAN_INTERVAL_SECONDS=2.0
OBS_MATCH_THRESHOLD=0.8
