---
// Texte de la FAQ : `**gras**` et `code`, rien d'autre. Découpé en éléments,
// jamais injecté comme HTML : un texte ne peut pas devenir du code.
interface Props { texte: string }
const morceaux = Astro.props.texte.split(/(\*\*[^*]+\*\*|`[^`]+`)/).filter(Boolean);
---
{morceaux.map((m) =>
  m.startsWith('**') ? <strong>{m.slice(2, -2)}</strong>
  : m.startsWith('`') ? <code>{m.slice(1, -1)}</code>
  : m
)}
