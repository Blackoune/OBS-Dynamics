---
// Chat Twitch : CSS repris de overlay_server.py (_CHAT_HTML). Messages
// fictifs, ajoutés par motion.ts avec textContent, comme le vrai overlay.
interface Props { messages: string[][] }
const { messages } = Astro.props;
---
<div class="chat-scene" data-demo="chat">
  <div class="chat-wrap" data-chat-wrap data-messages={JSON.stringify(messages)}></div>
</div>

<style>
  .chat-scene {
    position: relative; height: 19rem; overflow: hidden;
    /* Une scène de jeu stylisée derrière : le vrai overlay se pose sur le jeu. */
    background:
      linear-gradient(180deg, rgba(11, 15, 23, 0) 40%, rgba(11, 15, 23, .7)),
      repeating-linear-gradient(115deg, #1b2a3a 0 40px, #1f3242 40px 80px);
    font-family: 'Segoe UI', Inter, system-ui, sans-serif;
  }
  .chat-wrap {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    justify-content: flex-end; padding: 12px; gap: 8px; box-sizing: border-box;
  }
</style>

<style is:global>
  /* Éléments créés par motion.ts : hors de la portée des styles du composant. */
  .chat-wrap .msg {
    background: rgba(26, 21, 48, .55);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid rgba(168, 85, 247, .28);
    border-left: 3px solid var(--accent, #a855f7);
    border-radius: 12px; padding: 8px 12px; color: #f3f0fa; font-size: 15px;
    line-height: 1.35; box-shadow: 0 6px 20px rgba(0, 0, 0, .35);
    animation: chat-pop .18s ease-out; overflow-wrap: anywhere;
  }
  @keyframes chat-pop { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .chat-wrap .who { font-weight: 700; margin-right: 6px; }
  .chat-wrap .tag {
    display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .4px;
    text-transform: uppercase; padding: 1px 7px; border-radius: 999px; margin-right: 7px;
    color: #0f0c1b; vertical-align: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-wrap .msg { animation: none; }
  }
</style>
