---
// Widget musique : HTML et CSS repris de music_overlay.py (_PAGE_HTML), mêmes
// dispositions (data-layout) et mêmes 8 thèmes que music_style.TEMPLATES.
// Géométrie réduite à environ 70 % pour tenir dans la page. Morceau fictif.
const barres = Array.from({ length: 48 }, (_, i) => `l${(i * 7) % 3}`);
---
<div class="mw-scene" data-demo="widget">
  <div class="mw-card" data-layout="compact">
    <div class="mw-dots" hidden><i></i><i></i><i></i></div>
    <div class="mw-discbox"><div class="mw-disc"><span class="mw-label"></span></div></div>
    <div class="mw-frame" hidden><span class="mw-label"></span></div>
    <div class="mw-stack">
      <div class="mw-text">
        <div class="mw-title">Nuit blanche sur l'autoroute</div>
        <div class="mw-line">
          <span class="mw-artist">Les Ondes Courtes</span>
          <span class="mw-app">Spotify</span>
        </div>
      </div>
      <div class="mw-wave" aria-hidden="true">
        {barres.map((c) => <i class={c} />)}
      </div>
      <div class="mw-progress" hidden>
        <div class="mw-bar"><i class="mw-fill"></i></div>
        <div class="mw-times"><span>1:24</span><span>3:47</span></div>
      </div>
    </div>
    <div class="mw-controls" hidden aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M11 5v14L4 12zM20 5v14l-7-7z" /></svg>
      <svg viewBox="0 0 24 24"><path d="M7 4h4v16H7zM13 4h4v16h-4z" /></svg>
      <svg viewBox="0 0 24 24"><path d="M13 5v14l7-7zM4 5v14l7-7z" /></svg>
    </div>
  </div>
  <p class="mw-legende mono"><span data-mw-theme>Violet</span> · <span data-mw-layout>Compact</span></p>
</div>

<style>
  .mw-scene {
    --pad-y: 13px; --pad-l: 13px; --pad-r: 18px; --gap: 15px;
    --cover: 92px;
    --title-max: 300px; --title-size: 18px; --artist-max: 220px; --line-gap: 6px;
    --wave-h: 18px; --wave-gap: 8px;
    --bloc-pad: 8px; --bloc-gap: 7px; --bloc-wave: 112px;
    --minimal-pad-y: 9px; --minimal-pad-x: 14px; --minimal-title: 15px;
    --bandeau-pad-x: 21px; --bandeau-wave-h: 22px; --bandeau-wave-gap: 10px;
    --galerie-gap: 7px;
    /* Thème Violet, celui par défaut. Les autres sont posés par motion.ts. */
    --fond: rgba(15, 12, 27, .82); --contour: 1px solid #a855f7;
    --accent: #a855f7; --encre: #f3f0fa; --attenue: #a39bbd; --marque: #a855f7;

    display: grid; place-items: center; align-content: center; gap: 1rem;
    min-height: 17rem; padding: 1.5rem;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }
  .mw-card {
    display: flex; align-items: center; gap: var(--gap);
    padding: var(--pad-y) var(--pad-r) var(--pad-y) var(--pad-l);
    background: var(--fond); border: var(--contour); border-radius: 13px;
    width: max-content; max-width: 100%; position: relative;
  }
  .mw-card.avec-pastilles { padding-top: 31px; }
  .mw-scene [hidden] { display: none !important; }

  .mw-discbox { flex: 0 0 auto; line-height: 0; }
  .mw-disc {
    position: relative; width: var(--cover); height: var(--cover); border-radius: 50%;
    background: repeating-radial-gradient(circle at 50% 50%, #050509 0 2px, #15151f 2px 4px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, .55);
    animation: mw-spin 4s linear infinite;
  }
  .mw-disc::after {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: #0f0c1b; z-index: 2;
  }
  /* Pochette fictive : aplats, aucune image d'album réelle. */
  .mw-label {
    position: absolute; inset: 19%; border-radius: 50%;
    background: conic-gradient(#f97316 0 25%, #fde047 0 50%, #0ea5e9 0 75%, #e11d48 0);
  }
  @keyframes mw-spin { to { transform: rotate(360deg); } }

  .mw-frame {
    position: relative; flex: 0 0 auto; width: var(--cover); height: var(--cover);
    border-radius: 9px; overflow: hidden; box-shadow: 0 6px 18px rgba(0, 0, 0, .55);
  }
  .mw-frame .mw-label { inset: 0; border-radius: 0; }

  .mw-stack { display: flex; flex-direction: column; align-items: stretch; min-width: 0; }
  .mw-text { min-width: 0; }
  .mw-title {
    color: var(--encre); font-size: var(--title-size); font-weight: 700; line-height: 1.2;
    max-width: var(--title-max); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .mw-line { display: flex; align-items: center; gap: 7px; margin-top: var(--line-gap); min-width: 0; }
  .mw-artist { color: var(--attenue); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: var(--artist-max); }
  .mw-app {
    flex: 0 0 auto; color: var(--marque); font-size: 8.5px; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; border: 1px solid currentColor; border-radius: 999px; padding: 2px 8px;
  }
  .mw-wave { display: flex; align-items: flex-end; gap: 2px; height: var(--wave-h); margin-top: var(--wave-gap); }
  .mw-wave i {
    display: block; flex: 0 0 auto; width: 2px; height: 100%; border-radius: 2px;
    background: var(--accent); opacity: .85; transform: scaleY(.04); transform-origin: bottom;
  }
  .mw-wave i.l1 { width: 3px; }
  .mw-wave i.l2 { width: 4px; }

  .mw-card[data-layout='blocs'] { gap: var(--bloc-gap); align-items: stretch; }
  .mw-card[data-layout='blocs'] .mw-stack { display: contents; }
  .mw-card[data-layout='blocs'] :is(.mw-discbox, .mw-frame, .mw-text, .mw-wave) {
    padding: var(--bloc-pad); border-radius: 9px; border: 1px solid var(--accent);
    display: flex; flex-direction: column; justify-content: center;
  }
  .mw-card[data-layout='blocs'] .mw-wave { flex-direction: row; align-items: flex-end; height: auto; width: var(--bloc-wave); margin: 0; }
  .mw-card[data-layout='galerie'] { flex-direction: column; align-items: center; gap: var(--galerie-gap); }
  .mw-card[data-layout='galerie'] .mw-stack { align-items: flex-start; width: max-content; max-width: 100%; }
  .mw-card[data-layout='minimal'] { padding: var(--minimal-pad-y) var(--minimal-pad-x); }
  .mw-card[data-layout='minimal'] .mw-title { font-size: var(--minimal-title); }
  .mw-card[data-layout='bandeau'] { padding: var(--pad-y) var(--bandeau-pad-x); }
  .mw-card[data-layout='bandeau'] .mw-wave { height: var(--bandeau-wave-h); margin-top: var(--bandeau-wave-gap); }

  .mw-dots { position: absolute; top: 11px; left: 13px; display: flex; gap: 6px; }
  .mw-dots i { width: 8px; height: 8px; border-radius: 50%; display: block; background: #ff5f57; }
  .mw-dots i:nth-child(2) { background: #febc2e; }
  .mw-dots i:nth-child(3) { background: #28c840; }
  .mw-progress { margin-top: 10px; }
  .mw-bar { height: 3px; border-radius: 2px; background: color-mix(in srgb, var(--accent) 28%, transparent); overflow: hidden; }
  .mw-fill { display: block; height: 100%; width: 37%; border-radius: 2px; background: var(--encre); }
  .mw-times { display: flex; justify-content: space-between; margin-top: 6px; font-size: 9px; color: var(--attenue); }
  .mw-controls { display: flex; align-items: center; gap: 13px; flex: 0 0 auto; margin-left: 18px; }
  .mw-controls svg { width: 18px; height: 18px; fill: var(--encre); }

  .mw-legende { margin: 0; font-size: .75rem; color: var(--texte-doux); }

  /* Petit écran : même carte, géométrie réduite pour tenir dans le cadre. */
  @media (max-width: 520px) {
    .mw-scene {
      --cover: 60px; --gap: 10px; --title-max: 150px; --title-size: 14px; --artist-max: 110px;
      --bloc-wave: 60px; --wave-h: 14px; padding: 1rem .5rem;
    }
    .mw-wave i:nth-child(n+25) { display: none; }
    .mw-controls { margin-left: 8px; gap: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mw-disc { animation: none; }
  }
</style>
