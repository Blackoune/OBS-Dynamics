---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { LANGUES, lien, TEXTES, type Lang, type Page } from '../i18n';
import { CSP, GITHUB_URL, url } from '../site';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  /** Données structurées schema.org de la page (JSON-LD). */
  jsonLd?: object;
}
const { lang, page, title, description, jsonLd } = Astro.props;
const t = TEXTES[lang];
const absolu = (chemin: string) => new URL(chemin, Astro.site).href;
const canonique = absolu(lien(lang, page));
const image = absolu(url('og.png'));
// JSON-LD : `<` échappé, un texte ne peut pas refermer la balise <script>.
const ld = jsonLd && JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {LANGUES.map((l) => <link rel="alternate" hreflang={l} href={absolu(lien(l, page))} />)}
    <link rel="alternate" hreflang="x-default" href={absolu(lien('fr', page))} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OBS Dynamics" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <a class="evitement" href="#contenu">{t.commun.evitement}</a>
    <Nav lang={lang} page={page} />
    <main id="contenu">
      <slot />
    </main>
    <footer class="pied">
      <p class="pied-note">{t.commun.piedNote}</p>
      <ul class="pied-liens">
        <li><a href={lien(lang, 'comparatif')}>{t.commun.pied.comparatif}</a></li>
        <li><a href={lien(lang, 'mentions-legales')}>{t.commun.pied.mentions}</a></li>
        <li><a href={lien(lang, 'confidentialite')}>{t.commun.pied.confidentialite}</a></li>
        <li><a href={GITHUB_URL} rel="noopener noreferrer">{t.commun.pied.github}</a></li>
        <li><span>{t.commun.pied.licence}</span></li>
      </ul>
    </footer>
  </body>
</html>
