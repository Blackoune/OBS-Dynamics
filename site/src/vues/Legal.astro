---
import Base from '../layouts/Base.astro';
import { lien, TEXTES, type Lang } from '../i18n';

// Mentions légales et Confidentialité : même forme, des sections titrées.
interface Props { lang: Lang; page: 'mentions-legales' | 'confidentialite' }
const { lang, page } = Astro.props;
const t = page === 'mentions-legales' ? TEXTES[lang].mentions : TEXTES[lang].confidentialite;
const lienGithub = page === 'confidentialite' ? TEXTES[lang].confidentialite.lienGithub : null;
---
<Base lang={lang} page={page} title={t.titre} description={t.description}>
  <article class="legal">
    <h1 class="titre-page">{t.h1}</h1>
    {t.sections.map(([titre, texte]) => (
      <section>
        <h2>{titre}</h2>
        <p>{texte}</p>
      </section>
    ))}
    {lienGithub && (
      <p><a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener noreferrer">{lienGithub}</a></p>
    )}
    <p><a href={lien(lang, 'contact')}>{TEXTES[lang].commun.nav.contact}</a></p>
  </article>
</Base>

<style>
  .legal { max-width: 46rem; padding: clamp(3rem, 8vw, 5rem) 0 1rem; }
  .legal section { padding: 1.25rem 0; border-top: 1px solid var(--ligne); }
  .legal h2 { font-size: 1.15rem; margin: 0 0 .4rem; }
  .legal p { color: var(--texte-doux); margin: 0 0 1rem; }
</style>
