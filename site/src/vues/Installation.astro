---
import Base from '../layouts/Base.astro';
import Commande from '../components/Commande.astro';
import Texte from '../components/Texte.astro';
import { derniereRelease } from '../data/release';
import { TEXTES, type Lang } from '../i18n';
import { DISCORD, GITHUB_URL, REPO } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXTES[lang].installation;
const locale = TEXTES[lang].dateLocale;
const release = await derniereRelease();
const date = release?.date.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
const taille = release && `${(release.taille / 1024 / 1024).toLocaleString(locale, { maximumFractionDigits: 1 })} ${t.mo}`;
const sansMarques = (s: string) => s.replace(/\*\*|`/g, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.premiersPas.howto,
  inLanguage: lang,
  step: t.premiersPas.etapes.map(([nom, texte], i) => ({
    '@type': 'HowToStep', position: i + 1, name: nom, text: sansMarques(texte),
  })),
};
---
<Base lang={lang} page="installation" title={t.titre} description={t.description} jsonLd={jsonLd}>
  <header class="entete">
    <p class="surtitre">{t.surtitre}</p>
    <h1 class="titre-page">{t.h1}</h1>
    <p class="chapo">{t.chapo}</p>
  </header>

  <div class="os" role="tablist" aria-label={t.osAria} data-os-selecteur hidden>
    <button type="button" role="tab" id="onglet-windows" aria-controls="panneau-windows" data-os="windows">Windows</button>
    <button type="button" role="tab" id="onglet-mac" aria-controls="panneau-mac" data-os="mac">Mac</button>
  </div>

  <!-- ===================== Windows ===================== -->
  <section id="panneau-windows" class="panneau" role="tabpanel" aria-labelledby="onglet-windows" data-os-panneau="windows">
    <div class="telechargement">
      <div class="carte carte-principale">
        <h2 class="carte-titre">{t.windowsTitre}</h2>
        {release ? (
          <>
            <a class="btn btn-primaire btn-grand" href={release.telechargement}>{t.telecharger}</a>
            <dl class="fiche">
              <div><dt>{t.version}</dt><dd class="mono">{release.version}</dd></div>
              <div><dt>{t.publiee}</dt><dd>{date}</dd></div>
              <div><dt>{t.taille}</dt><dd>{taille}</dd></div>
              <div class="fiche-large">
                <dt>SHA-256</dt>
                <dd><Commande texte={release.sha256} lang={lang} /></dd>
              </div>
            </dl>
            <p class="lien-rapport">
              <a href={release.virustotal} rel="noopener noreferrer">{t.rapportVt}</a>
            </p>
          </>
        ) : (
          <>
            <p class="bientot">{t.bientot}</p>
            <p class="texte-doux">{t.enAttendant[0]}<a href="#sources">{t.enAttendant[1]}</a>{t.enAttendant[2]}</p>
          </>
        )}
        <p class="prerequis">
          {t.prerequis[0]}<a href="https://obsproject.com/" rel="noopener noreferrer">{t.prerequis[1]}</a>{t.prerequis[2]}
        </p>
      </div>

      {(!release || !release.signe) && (
        <aside class="carte smartscreen" aria-labelledby="titre-smartscreen">
          <h2 id="titre-smartscreen" class="carte-titre">{t.smartscreen.titre}</h2>
          <p>{t.smartscreen.intro}</p>
          <ol class="etapes-courtes">
            {t.smartscreen.etapes.map((e) => <li><Texte texte={e} /></li>)}
          </ol>
          <p class="texte-doux">{t.smartscreen.apres}</p>
        </aside>
      )}
    </div>

    <section class="bloc" aria-labelledby="titre-verifier" id="verifier">
      <h2 id="titre-verifier" class="bloc-titre">{t.verifier.titre}</h2>
      <div class="colonnes">
        <div>
          <h3>{t.verifier.empreinteTitre}</h3>
          <p>{t.verifier.empreinteIntro}</p>
          <Commande texte="Get-FileHash .\Dynamics.exe -Algorithm SHA256" lang={lang} />
          <p class="texte-doux">{t.verifier.empreinteApres}</p>
        </div>
        <div>
          <h3>{t.verifier.attestationTitre}</h3>
          <p>{t.verifier.attestationIntro[0]}<a href="https://cli.github.com/" rel="noopener noreferrer">{t.verifier.attestationIntro[1]}</a>{t.verifier.attestationIntro[2]}</p>
          <Commande texte={`gh attestation verify .\\Dynamics.exe --repo ${REPO}`} lang={lang} />
          <p class="texte-doux">{t.verifier.attestationApres}</p>
        </div>
      </div>
    </section>

    <section class="bloc" aria-labelledby="titre-premiers-pas">
      <h2 id="titre-premiers-pas" class="bloc-titre">{t.premiersPas.titre}</h2>
      <ol class="premiers-pas">
        {t.premiersPas.etapes.map(([titre, texte]) => (
          <li>
            <h3>{titre}</h3>
            <p><Texte texte={texte} /></p>
          </li>
        ))}
      </ol>
    </section>

    <section class="bloc" aria-labelledby="titre-sources" id="sources">
      <h2 id="titre-sources" class="bloc-titre">{t.sources.titre}</h2>
      <p>{t.sources.intro}</p>
      <div class="pile">
        <Commande etiquette="1" texte={`git clone ${GITHUB_URL}.git`} lang={lang} />
        <Commande etiquette="2" texte="cd OBS-Dynamics" lang={lang} />
        <Commande etiquette="3" texte="pip install -r requirements.txt" lang={lang} />
        <Commande etiquette="4" texte="python obs_dynamics.py" lang={lang} />
      </div>
      <p><a class="btn btn-secondaire" href={GITHUB_URL} rel="noopener noreferrer">{t.sources.voirCode}</a></p>
    </section>
  </section>

  <!-- ======================= Mac ======================= -->
  <section id="panneau-mac" class="panneau" role="tabpanel" aria-labelledby="onglet-mac" data-os-panneau="mac">
    <div class="carte carte-mac">
      <p class="surtitre">macOS</p>
      <h2 class="carte-titre">{t.mac.titre}</h2>
      <p>{t.mac.texte}</p>
      {DISCORD.general && (
        <a class="btn btn-primaire" href={DISCORD.general} rel="noopener noreferrer">{t.mac.prevenir}</a>
      )}
    </div>
  </section>
</Base>

<script>
  import '../scripts/os';
</script>

<style>
  .entete { padding: clamp(3rem, 8vw, 5rem) 0 2rem; }

  .os {
    display: inline-flex; gap: .15rem; padding: .3rem; margin-bottom: 2rem;
    border: 1px solid var(--ligne); border-radius: .75rem; background: var(--surface);
  }
  .os[hidden] { display: none; }
  .os button {
    font: inherit; font-weight: 600; color: var(--texte-doux);
    background: none; border: 0; border-radius: .5rem;
    padding: .5rem 1.4rem; cursor: pointer;
  }
  .os button[aria-selected='true'] {
    color: var(--texte); background: var(--surface-haute);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .panneau + .panneau { margin-top: 4rem; }

  .carte {
    border: 1px solid var(--ligne); border-radius: 1rem;
    background: var(--surface); padding: clamp(1.25rem, 3vw, 2rem);
  }
  .carte-titre { font-size: 1.35rem; margin: 0 0 1.25rem; font-variation-settings: 'wdth' 85; }

  .telechargement {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1.5rem; align-items: start;
  }
  .btn-grand { font-size: 1.1rem; padding: 1rem 1.6rem; }

  .fiche { display: grid; grid-template-columns: repeat(3, auto); gap: 1rem 2rem; margin: 1.75rem 0 1rem; justify-content: start; }
  .fiche div { min-width: 0; }
  .fiche-large { grid-column: 1 / -1; }
  .fiche dt { font-size: .8rem; color: var(--texte-doux); font-family: var(--mono); text-transform: uppercase; letter-spacing: .06em; }
  .fiche dd { margin: .2rem 0 0; }

  .bientot { font-size: 1.3rem; font-weight: 700; margin: 0 0 .5rem; }
  .prerequis { margin: 1.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--ligne); font-size: .95rem; color: var(--texte-doux); }
  .lien-rapport { margin: .5rem 0 0; font-size: .95rem; }
  .texte-doux { color: var(--texte-doux); }

  .smartscreen { border-color: #3a3320; background: #16140d; }
  .smartscreen .carte-titre { color: #fcd34d; }
  .etapes-courtes { padding-left: 1.25rem; }
  .etapes-courtes li { margin: .35rem 0; }

  .bloc { margin-top: clamp(4rem, 8vw, 6rem); }
  .bloc-titre {
    font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.05; margin: 0 0 1.75rem;
    font-variation-settings: 'wdth' 75; letter-spacing: -.01em;
  }
  .bloc h3 { font-size: 1.1rem; margin: 0 0 .5rem; }
  .colonnes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; }
  .pile { display: grid; gap: .5rem; margin: 1rem 0 1.5rem; max-width: 40rem; }

  .premiers-pas { list-style: none; counter-reset: pas; padding: 0; margin: 0; display: grid; gap: 0; }
  .premiers-pas li {
    counter-increment: pas;
    display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: .4rem 1.5rem;
    padding: 1.75rem 0; border-top: 1px solid var(--ligne);
  }
  .premiers-pas li > * { grid-column: 2; }
  .premiers-pas li::before {
    grid-row: 1 / span 2;
    content: '0' counter(pas);
    font-family: var(--mono); font-size: 2.2rem; line-height: 1; color: var(--accent);
  }
  .premiers-pas p { margin: 0; color: var(--texte-doux); max-width: 42rem; }

  .carte-mac { max-width: 38rem; }

  @media (max-width: 800px) {
    .telechargement, .colonnes { grid-template-columns: 1fr; }
    .fiche { grid-template-columns: repeat(2, auto); }
    .premiers-pas li { grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; }
  }
</style>
