---
import Base from '../layouts/Base.astro';
import { lien, TEXTES, type Lang } from '../i18n';
import { GITHUB_URL } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXTES[lang].comparatif;
---
<Base lang={lang} page="comparatif" title={t.titre} description={t.description}>
  <header class="entete">
    <p class="surtitre">{TEXTES[lang].commun.pied.comparatif}</p>
    <h1 class="titre-page">{t.h1}</h1>
    <p class="chapo">{t.chapo}</p>
  </header>

  <div class="defile">
    <table>
      <thead>
        <tr>{t.colonnes.map((col, i) => (i === 0 ? <td></td> : <th scope="col">{col}</th>))}</tr>
      </thead>
      <tbody>
        {t.lignes.map(([critere, ...valeurs]) => (
          <tr>
            <th scope="row">{critere}</th>
            {valeurs.map((v) => <td>{v}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="forces" aria-labelledby="titre-forces">
    <h2 id="titre-forces" class="bloc-titre">{t.forcesTitre}</h2>
    <dl>
      {t.outils.map(([nom, texte]) => <div><dt>{nom}</dt><dd>{texte}</dd></div>)}
    </dl>
    <p class="note">{t.note} <a href={GITHUB_URL + '/issues'} rel="noopener noreferrer">GitHub</a></p>
    <p><a class="btn btn-primaire" href={lien(lang, 'installation')}>{TEXTES[lang].commun.telechargerWindows}</a></p>
  </section>
</Base>

<style>
  .entete { padding: clamp(3rem, 8vw, 5rem) 0 2rem; }
  .defile { overflow-x: auto; border: 1px solid var(--ligne); border-radius: 1rem; }
  table { width: 100%; border-collapse: collapse; min-width: 44rem; font-size: .95rem; }
  th, td { text-align: left; vertical-align: top; padding: .9rem 1rem; border-bottom: 1px solid var(--ligne); }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font-size: .8rem; font-family: var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--texte-doux); }
  thead th:nth-child(2) { color: var(--accent); }
  tbody th { font-weight: 600; width: 16%; }
  tbody td { color: var(--texte-doux); }
  tbody td:nth-child(2) { color: var(--texte); background: var(--surface); }
  .forces { margin-top: clamp(3.5rem, 7vw, 5rem); }
  .bloc-titre { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.05; margin: 0 0 1.5rem; font-variation-settings: 'wdth' 75; }
  .forces dl { margin: 0 0 2rem; max-width: 50rem; }
  .forces dl div { padding: 1.1rem 0; border-top: 1px solid var(--ligne); }
  .forces dt { font-weight: 700; margin-bottom: .3rem; }
  .forces dd { margin: 0; color: var(--texte-doux); }
  .note { color: var(--texte-doux); font-size: .9rem; max-width: 50rem; margin-bottom: 2rem; }
</style>
