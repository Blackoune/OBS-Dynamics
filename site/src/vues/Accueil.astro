---
import Base from '../layouts/Base.astro';
import Texte from '../components/Texte.astro';
import Chat from '../components/demo/Chat.astro';
import Widget from '../components/demo/Widget.astro';
import { derniereRelease } from '../data/release';
import { lien, TEXTES, type Lang } from '../i18n';
import { GITHUB_URL, REPO } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXTES[lang].accueil;
const c = TEXTES[lang].commun;
const m = t.modules;
const release = await derniereRelease();

// Libellé « Paramètres » de l'application, tel quel dans ses 39 langues (i18n.json).
const langues = [
  ['fr', 'Paramètres'], ['en', 'Settings'], ['es', 'Ajustes'], ['id', 'Pengaturan'], ['ms', 'Tetapan'],
  ['cs', 'Nastavení'], ['da', 'Indstillinger'], ['de', 'Einstellungen'], ['et', 'Seaded'], ['tl', 'Mga Setting'],
  ['ha', 'Saituna'], ['hr', 'Postavke'], ['it', 'Impostazioni'], ['sw', 'Mipangilio'], ['lv', 'Iestatījumi'],
  ['lt', 'Nustatymai'], ['hu', 'Beállítások'], ['nl', 'Instellingen'], ['nb', 'Innstillinger'], ['pl', 'Ustawienia'],
  ['pt', 'Configurações'], ['ro', 'Setări'], ['sk', 'Nastavenia'], ['sl', 'Nastavitve'], ['fi', 'Asetukset'],
  ['sv', 'Inställningar'], ['vi', 'Cài đặt'], ['tr', 'Ayarlar'], ['ru', 'Настройки'], ['uk', 'Налаштування'],
  ['ur', 'ترتیبات'], ['ar', 'الإعدادات'], ['fa', 'تنظیمات'], ['hi', 'सेटिंग्स'], ['bn', 'সেটিংস'],
  ['th', 'การตั้งค่า'], ['zh', '设置'], ['ja', '設定'], ['ko', '설정'],
];
// La langue de la page en premier : c'est elle qu'on lit sans JavaScript.
const ordre = [...langues.filter(([code]) => code === lang), ...langues.filter(([code]) => code !== lang)];

// Jeux fictifs : aucune jaquette réelle (droits). Couleurs posées en CSS.
const jeux = [
  ['Forge Noire', true], ['Rally 86', false], ['Orbite', false], ['Les Marais', false],
  ['Kilowatt', true], ['Tour de garde', false], ['Atlas', false], ['Néon Run', false],
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OBS Dynamics',
  description: t.description,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows 10, Windows 11',
  inLanguage: lang,
  url: new URL(lien(lang), Astro.site).href,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  codeRepository: GITHUB_URL,
  author: { '@type': 'Person', name: 'Blackoune' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  ...(release && {
    softwareVersion: release.version.replace(/^v/, ''),
    downloadUrl: `https://github.com/${REPO}/releases/latest/download/Dynamics.exe`,
  }),
};
---
<Base lang={lang} page="" title={t.titre} description={t.description} jsonLd={jsonLd}>
  <!-- ============================ Accroche ============================ -->
  <section class="accroche">
    <div>
      <p class="surtitre">{t.surtitre}</p>
      <h1 class="titre-page" data-motion-titre>{t.h1}</h1>
      <p class="chapo">{t.chapo}</p>
      <div class="actions">
        <a class="btn btn-primaire" href={lien(lang, 'installation')}>{c.telechargerWindows}</a>
        <a class="btn btn-secondaire" href={GITHUB_URL} rel="noopener noreferrer">{c.voirGithub}</a>
      </div>
    </div>

    <div class="regie" aria-hidden="true" data-motion="regie"
      data-lecture={t.regie.statutLecture} data-menu={t.regie.statutMenu} data-jeu={t.regie.statutJeu}>
      <div class="ecran" data-etat="jeu">
        <div class="ecran-menu">
          <span class="ecran-logo">VALORANT</span>
          <ul>{t.regie.menu.map((item, i) => <li class:list={{ actif: i === 0 }}>{item}</li>)}</ul>
        </div>
        <div class="ecran-jeu">
          <span class="hud-carte"></span>
          <span class="hud-viseur"></span>
          <span class="hud-vie mono">100</span>
          <span class="hud-munitions mono">25 <i>/ 75</i></span>
        </div>
        <span class="ecran-scan"></span>
      </div>
      <div class="obs">
        <p class="obs-titre mono">{t.regie.scenes}</p>
        <ul>
          <li class="mono" data-scene="menu">{t.regie.sceneMenu}</li>
          <li class="mono actif" data-scene="jeu">{t.regie.sceneJeu}</li>
          <li class="mono">{t.regie.pause}</li>
        </ul>
        <p class="obs-statut mono"><span class="point"></span><span data-statut>{t.regie.statutJeu}</span></p>
      </div>
    </div>
  </section>

  <!-- ======================= Comment ça marche ======================= -->
  <section class="mecanisme" aria-labelledby="titre-mecanisme" data-motion="mecanisme">
    <div>
      <h2 id="titre-mecanisme" class="section-titre">{t.mecanisme.titre}</h2>
      <ol class="temps">
        {t.mecanisme.temps.map(([titre, texte], i) => (
          <li data-temps={i + 1}>
            <span class="temps-num mono">0{i + 1}</span>
            <div><h3>{titre}</h3><p>{texte}</p></div>
          </li>
        ))}
      </ol>
    </div>

    <div class="mecanisme-scene" aria-hidden="true">
      <div class="panneau-m" data-panneau="1">
        <p class="panneau-titre mono">{t.mecanisme.processus}</p>
        <ul class="processus mono">
          <li>explorer.exe</li><li>Discord.exe</li><li>obs64.exe</li>
          <li class="trouve">VALORANT-Win64-Shipping.exe <b>{t.mecanisme.reconnu}</b></li>
          <li>Spotify.exe</li>
        </ul>
      </div>
      <div class="panneau-m" data-panneau="2">
        <p class="panneau-titre mono">{t.mecanisme.cadrage}</p>
        <div class="cadrage">
          {[1, 2, 3, 4, 5, 6].map((n) => <span class={`cadre c${n}`}><i class="mono">{n}</i></span>)}
        </div>
        <dl class="scores mono">
          <div><dt>{t.mecanisme.scoreMenu}</dt><dd><span class="jauge"><i class="j-menu"></i></span>{t.mecanisme.valeurs[0]}</dd></div>
          <div><dt>{t.mecanisme.scoreJeu}</dt><dd><span class="jauge"><i class="j-jeu"></i></span>{t.mecanisme.valeurs[1]}</dd></div>
          <div class="marge"><dt>{t.mecanisme.marge}</dt><dd>{t.mecanisme.valeurs[2]}</dd></div>
        </dl>
      </div>
      <div class="panneau-m" data-panneau="3">
        <p class="panneau-titre mono">OBS Studio</p>
        <ul class="obs-liste mono">
          <li>{t.regie.sceneMenu}</li>
          <li class="entree">{t.regie.sceneJeu}</li>
          <li>{t.regie.pause}</li>
        </ul>
        <p class="mono requete">SetCurrentProgramScene → « {t.regie.sceneJeu} »</p>
      </div>
    </div>
  </section>

  <!-- ============================ Modules ============================ -->
  <section class="modules" aria-labelledby="titre-modules">
    <h2 id="titre-modules" class="section-titre">{m.titre}</h2>

    <article class="module">
      <div class="module-texte">
        <p class="module-num mono">{m.biblio[0]}</p>
        <h3>{m.biblio[1]}</h3>
        <p>{m.biblio[2]}</p>
      </div>
      <div class="demo">
        <ul class="biblio" data-colonnes="4" data-motion="biblio">
          {jeux.map(([nom, actif]) => (
            <li class="jaquette">
              <span class="jaquette-image"></span>
              <span class="jaquette-nom">{nom}</span>
              <span class:list={['pastille', { actif }]}>{actif ? m.actif : m.inactif}</span>
            </li>
          ))}
        </ul>
      </div>
    </article>

    <article class="module module-inverse">
      <div class="module-texte">
        <p class="module-num mono">{m.hotkeys[0]}</p>
        <h3>{m.hotkeys[1]}</h3>
        <p><Texte texte={m.hotkeys[2]} /></p>
      </div>
      <div class="demo demo-touches" data-motion="hotkeys">
        <div class="touches">
          {m.touches.map((etat, i) => <span class="touche"><b>F{i + 1}</b><small>{etat}</small></span>)}
        </div>
        <p class="etat-force mono">{m.etatForce} <span data-etat-force>{m.touches[0]}</span></p>
      </div>
    </article>

    <article class="module">
      <div class="module-texte">
        <p class="module-num mono">{m.raccourcis[0]}</p>
        <h3>{m.raccourcis[1]}</h3>
        <p>{m.raccourcis[2]}</p>
      </div>
      <div class="demo demo-raccourci" data-motion="raccourci">
        <div class="combo">
          <span class="touche petite">Ctrl</span><span class="plus">+</span>
          <span class="touche petite">{m.maj}</span><span class="plus">+</span>
          <span class="touche petite">M</span>
          <span class="mode mono">{m.maintien}</span>
        </div>
        <div class="mini-ecran">
          <span class="mini-carte"></span>
          <span class="cache mono">{m.carteMasquee}</span>
        </div>
      </div>
    </article>

    <article class="module module-inverse">
      <div class="module-texte">
        <p class="module-num mono">{m.chat[0]}</p>
        <h3>{m.chat[1]}</h3>
        <p>{m.chat[2]}</p>
      </div>
      <div class="demo"><Chat messages={m.messages} /></div>
    </article>

    <article class="module">
      <div class="module-texte">
        <p class="module-num mono">{m.widget[0]}</p>
        <h3>{m.widget[1]}</h3>
        <p>{m.widget[2]}</p>
      </div>
      <div class="demo"><Widget /></div>
    </article>

    <article class="module module-inverse">
      <div class="module-texte">
        <p class="module-num mono">{m.langues[0]}</p>
        <h3>{m.langues[1]}</h3>
        <p>{m.langues[2]}</p>
      </div>
      <div class="demo demo-langues" data-motion="langues">
        <p class="mot" data-mot lang={ordre[0][0]}>{ordre[0][1]}</p>
        <ul class="langues mono">
          {ordre.map(([code, mot]) => <li lang={code}>{mot}</li>)}
        </ul>
      </div>
    </article>
  </section>

  <!-- ============================ Confiance ============================ -->
  <section class="confiance" aria-labelledby="titre-confiance">
    <h2 id="titre-confiance" class="section-titre">{t.confiance.titre}</h2>
    <dl class="garanties">
      {t.confiance.items.map(([titre, texte], i) => (
        <div>
          <dt>{titre}</dt>
          <dd>
            {texte}
            {i === t.confiance.items.length - 1 && <a href={`${lien(lang, 'installation')}#verifier`}>{t.confiance.verifier}</a>}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ======================== Questions courtes ======================== -->
  <section class="questions" aria-labelledby="titre-questions">
    <h2 id="titre-questions" class="section-titre">{t.questions.titre}</h2>
    <dl>
      {t.questions.items.map(([q, r]) => <div><dt>{q}</dt><dd>{r}</dd></div>)}
    </dl>
    <p><a href={lien(lang, 'contact')}>{t.questions.toutes}</a></p>
  </section>

  <!-- =========================== Appel final =========================== -->
  <section class="appel">
    <h2 class="appel-titre">{t.appel}</h2>
    <a class="btn btn-primaire btn-grand" href={lien(lang, 'installation')}>{c.telechargerWindows}</a>
  </section>
</Base>

<script>
  import '../scripts/motion';
</script>

<style>
  /* ---------- Accroche ---------- */
  .accroche {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem); align-items: center;
    padding: clamp(3rem, 9vw, 6.5rem) 0 clamp(3rem, 8vw, 6rem);
  }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; }
  .btn-grand { font-size: 1.1rem; padding: 1rem 1.6rem; }

  .regie { display: grid; gap: .75rem; }
  .ecran {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    border: 1px solid var(--ligne); border-radius: .75rem; background: #0d1520;
  }
  .ecran > div { position: absolute; inset: 0; transition: opacity .45s; }
  .ecran-menu {
    padding: 8% 9%; display: flex; flex-direction: column; justify-content: center; gap: 1rem;
    background: radial-gradient(120% 90% at 85% 50%, #3b1d22 0, #120d14 60%);
  }
  .ecran-logo { font-weight: 800; font-variation-settings: 'wdth' 125; letter-spacing: .12em; color: #ff4655; font-size: clamp(.9rem, 2vw, 1.25rem); }
  .ecran-menu ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; }
  .ecran-menu li { font-size: clamp(.7rem, 1.4vw, .9rem); color: #b8b2bf; text-transform: uppercase; letter-spacing: .08em; }
  .ecran-menu li.actif { color: #fff; }
  .ecran-jeu { background: repeating-linear-gradient(115deg, #1b2a3a 0 30px, #1f3242 30px 60px); }
  .hud-carte { position: absolute; top: 7%; left: 5%; width: 18%; aspect-ratio: 1; border: 2px solid rgba(255, 255, 255, .5); border-radius: .3rem; background: rgba(9, 14, 20, .55); }
  .hud-viseur { position: absolute; top: 50%; left: 50%; width: 14px; height: 14px; margin: -7px; border: 2px solid #4ade80; border-radius: 50%; }
  .hud-vie, .hud-munitions { position: absolute; bottom: 7%; font-size: clamp(.8rem, 1.8vw, 1.15rem); color: #fff; font-weight: 700; }
  .hud-vie { left: 6%; }
  .hud-munitions { right: 6%; }
  .hud-munitions i { font-style: normal; color: #9aa4b2; font-weight: 400; }
  .ecran[data-etat='jeu'] .ecran-menu, .ecran[data-etat='menu'] .ecran-jeu { opacity: 0; }
  .ecran-scan {
    position: absolute; top: 0; bottom: 0; left: 0; width: 30%; pointer-events: none; opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, .25), transparent);
  }

  .obs { border: 1px solid var(--ligne); border-radius: .75rem; background: var(--surface); padding: .9rem; }
  .obs-titre { font-size: .7rem; color: var(--texte-doux); margin: 0 .4rem .5rem; }
  .obs ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; }
  .obs li { padding: .45rem .6rem; border-radius: .35rem; font-size: .8rem; color: var(--texte-doux); transition: background-color .3s, color .3s, box-shadow .3s; }
  .obs li.actif { background: var(--surface-haute); color: var(--texte); box-shadow: inset 2px 0 0 var(--accent); }
  .obs-statut { margin: .7rem .4rem 0; font-size: .72rem; color: var(--texte-doux); display: flex; align-items: center; gap: .5rem; }
  .point { width: .5rem; height: .5rem; border-radius: 50%; background: #4ade80; }

  /* ---------- Sections ---------- */
  .section-titre {
    font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1; letter-spacing: -.015em; margin: 0 0 2.5rem;
    font-variation-settings: 'wdth' 70; font-weight: 800;
  }

  /* ---------- Comment ça marche ---------- */
  .mecanisme {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem); align-items: center;
    padding: clamp(4rem, 8vw, 6rem) 0; border-top: 1px solid var(--ligne);
  }
  .temps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .temps li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; transition: opacity .3s; }
  .temps-num { color: var(--accent); padding-top: .2rem; }
  .temps h3 { margin: 0 0 .3rem; font-size: 1.2rem; }
  .temps p { margin: 0; color: var(--texte-doux); }

  .mecanisme-scene { display: grid; gap: 1rem; }
  .panneau-m { border: 1px solid var(--ligne); border-radius: .9rem; background: var(--surface); padding: 1.1rem 1.25rem; }
  .panneau-titre { font-size: .7rem; color: var(--texte-doux); margin: 0 0 .75rem; }
  .processus, .obs-liste { list-style: none; margin: 0; padding: 0; font-size: .8rem; display: grid; gap: .15rem; }
  .processus li, .obs-liste li { padding: .4rem .6rem; border-radius: .35rem; color: var(--texte-doux); }
  .processus .trouve { color: var(--texte); background: var(--surface-haute); box-shadow: inset 2px 0 0 var(--accent); display: flex; justify-content: space-between; gap: 1rem; }
  .processus b { color: var(--accent); font-weight: 500; }
  .cadrage {
    position: relative; aspect-ratio: 16 / 7; border-radius: .5rem; overflow: hidden;
    background: repeating-linear-gradient(115deg, #1b2a3a 0 26px, #1f3242 26px 52px);
  }
  .cadre { position: absolute; border: 1.5px dashed var(--accent); border-radius: .25rem; }
  .cadre i { position: absolute; top: -.1rem; left: .2rem; font-size: .6rem; font-style: normal; color: var(--accent); }
  .c1 { top: 8%; left: 4%; width: 18%; height: 38%; }
  .c2 { bottom: 8%; left: 5%; width: 13%; height: 20%; }
  .c3 { bottom: 8%; right: 5%; width: 18%; height: 20%; }
  .c4 { top: 42%; left: 46%; width: 8%; height: 18%; }
  .c5 { top: 8%; right: 30%; width: 22%; height: 14%; }
  .c6 { top: 8%; right: 5%; width: 10%; height: 14%; }
  .scores { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: .5rem 1.75rem; margin: .9rem 0 0; font-size: .75rem; }
  .scores dt { color: var(--texte-doux); }
  .scores dd { margin: .15rem 0 0; display: flex; align-items: center; gap: .5rem; }
  .jauge { width: 4.5rem; height: .3rem; border-radius: 1rem; background: var(--ligne); overflow: hidden; }
  .jauge i { display: block; height: 100%; background: var(--texte-doux); transform-origin: left; }
  .j-menu { transform: scaleX(.31); }
  .jauge .j-jeu { transform: scaleX(.94); background: var(--accent); }
  .marge dd { color: #4ade80; }
  .obs-liste .entree { color: var(--texte); background: var(--surface-haute); box-shadow: inset 2px 0 0 var(--accent); }
  .requete { margin: .75rem 0 0; font-size: .72rem; color: var(--texte-doux); }

  /* Grand écran avec JavaScript : panneaux superposés, section épinglée
     (motion.ts pose la classe .epingle). Sans elle : les trois empilés. */
  .mecanisme.epingle .mecanisme-scene { position: relative; min-height: 22rem; }
  .mecanisme.epingle .panneau-m { position: absolute; inset: 0 0 auto; }
  .mecanisme.epingle .temps li { opacity: .3; }
  .mecanisme.epingle .temps li.actif { opacity: 1; }

  /* ---------- Modules ---------- */
  .modules { padding: clamp(4rem, 8vw, 6rem) 0; border-top: 1px solid var(--ligne); }
  .module {
    display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding: clamp(2.5rem, 5vw, 4rem) 0;
  }
  .module-inverse .module-texte { order: 2; }
  .module-num { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: 0 0 .75rem; }
  .module h3 { font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.1; margin: 0 0 1rem; font-variation-settings: 'wdth' 82; }
  .module-texte > p:last-child { color: var(--texte-doux); margin: 0; }
  .module-texte code { color: var(--texte); }
  .demo { border: 1px solid var(--ligne); border-radius: 1rem; background: var(--surface); overflow: hidden; }

  .biblio { list-style: none; margin: 0; padding: 1rem; display: grid; gap: .6rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .biblio[data-colonnes='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .biblio[data-colonnes='8'] { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  .jaquette { display: grid; gap: .3rem; min-width: 0; align-content: start; }
  .jaquette-image { aspect-ratio: 2 / 3; border-radius: .35rem; background: #57534e; }
  .jaquette:nth-child(1) .jaquette-image { background: #b45309; }
  .jaquette:nth-child(2) .jaquette-image { background: #0f766e; }
  .jaquette:nth-child(3) .jaquette-image { background: #4338ca; }
  .jaquette:nth-child(4) .jaquette-image { background: #3f6212; }
  .jaquette:nth-child(5) .jaquette-image { background: #be123c; }
  .jaquette:nth-child(7) .jaquette-image { background: #0369a1; }
  .jaquette:nth-child(8) .jaquette-image { background: #a21caf; }
  .jaquette-nom { font-size: .72rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pastille { justify-self: start; font-size: .6rem; padding: .05rem .4rem; border-radius: 1rem; background: var(--ligne); color: var(--texte-doux); }
  .pastille.actif { background: #14532d; color: #86efac; }
  .biblio[data-colonnes='8'] :is(.jaquette-nom, .pastille) { display: none; }

  .demo-touches, .demo-raccourci { padding: 2rem 1.5rem; display: grid; gap: 1.5rem; justify-items: center; }
  .touches { display: flex; gap: .9rem; }
  .touche {
    display: grid; justify-items: center; gap: .15rem; min-width: 4.5rem; padding: .7rem .8rem .55rem;
    border-radius: .6rem; background: var(--surface-haute); border: 1px solid var(--ligne);
    box-shadow: 0 4px 0 #070a10; color: var(--texte);
    transition: transform .08s, box-shadow .08s, border-color .08s;
  }
  .touche b { font-family: var(--mono); font-size: 1.15rem; }
  .touche small { font-size: .7rem; color: var(--texte-doux); }
  .touche.enfoncee { transform: translateY(3px); box-shadow: 0 1px 0 #070a10; border-color: var(--accent); }
  .etat-force { margin: 0; font-size: .85rem; color: var(--texte-doux); }
  .etat-force span { color: var(--accent); }

  .combo { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; justify-content: center; }
