# Copier ce fichier en `.env` DANS LE PROFIL UTILISATEUR, pas ici :
#     Windows      %APPDATA%\OBS Dynamics\.env
#     Linux/macOS  ~/.config/OBS Dynamics/.env
#
# L'application y migre automatiquement un ancien `.env` resté à la racine
# du dépôt (il est renommé `.env.old`, rien n'est supprimé). Les
# identifiants survivent ainsi aux purges d'historique et aux `git clean`,
# et ne peuvent structurellement pas être committés.
#
# Ce fichier liste EXACTEMENT les clés lues par EnvConfigManager
# (obs_dynamics.py, dictionnaire ENV_KEYS). Toute autre clé est ignorée.

# --- Connexion OBS WebSocket v5 ---
# Dans OBS : Outils > Paramètres du serveur WebSocket.
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=changeme

# --- Boucle de surveillance ---
# Intervalle entre deux scans, en secondes (plancher appliqué : 0.5).
OBS_SCAN_INTERVAL_SECONDS=2.0
# Score minimal de correspondance visuelle OpenCV, entre 0.0 et 1.0.
OBS_MATCH_THRESHOLD=0.8

# --- Interface ---
# Langue de l'application : fr, en ou es.
OBS_APP_LANG=fr

# --- Jaquettes (optionnel) ---
# Sans clé, les jaquettes Steam fonctionnent quand même via l'appid et la
# recherche du Steam Store. Une clé RAWG améliore la couverture des jeux
# non-Steam. Gratuite sur https://rawg.io/apidocs
RAWG_API_KEY=

# --- Raccourcis & Overlays ---
# Port du serveur HTTP local qui alimente les sources navigateur OBS.
# Le changer invalide les URL déjà collées dans OBS : à ne toucher qu'en cas
# de conflit avec un autre logiciel.
OBS_OVERLAY_PORT=4466
