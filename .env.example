# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit real credentials.

OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=changeme

# Optional tuning (defaults shown)
OBS_WS_CONNECT_TIMEOUT=10.0
OBS_WS_RECONNECT_BASE_DELAY=1.0
OBS_WS_RECONNECT_MAX_DELAY=60.0
OBS_WS_RECONNECT_MAX_ATTEMPTS=0
OBS_WS_HEARTBEAT_INTERVAL=15.0

OBS_SCAN_INTERVAL_SECONDS=1.0
OBS_MATCH_THRESHOLD=0.8

OBS_DEBUG=false
