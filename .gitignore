__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
# *.spec  -> build.spec est un fichier source requis par build.py, il DOIT etre versionne
.env
obs_automation.log
logs/
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Secrets: legacy config files that historically held plaintext credentials.
# The active source of truth for secrets is `.env` (see .env.example).
obs_config.json
config.json

data/
# Exception : code source du site (FAQ, lecture des releases), pas des données.
!site/src/data/

# Artefacts Visual Studio (index Copilot, sqlite de session).
.vs/

# Exécutables packagés : ne jamais versionner (74 Mo par build).
*.exe
dist_release/

# Sauvegardes locales de .env produites par les scripts de maintenance.
.env.backup
# Ancien .env laisse en place apres migration vers %APPDATA%.
.env.old

# Cache pytest.
.pytest_cache/

graphify-out/

# Journal du rebuild automatique du .exe (hook post-commit).
build_auto.log

# Journaux et anciens dossiers de donnees : un message d erreur `requests`
# recopie l URL appelee, cle comprise (fuite d une cle de stream en 833d1df).
data.old/
*.log
*.log.[0-9]
